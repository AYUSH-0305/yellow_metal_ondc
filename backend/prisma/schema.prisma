generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                  String   @id @default(uuid())
  distributor_ref_id  String?  @unique
  borrower_name       String
  mobile_number       String
  address             String?
  pincode             String?
  dob                 DateTime?
  
  gold_weight_grams   Float
  interest_rate_pct   Float?
  tenure_months       Int?
  ltv_pct             Float?
  
  status              String   @default("new")
  duplicate_flag      Boolean  @default(false)
  existing_lead_id    String?

  disbursement_details String?
  rejection_reason     String?

  branch_officer_name  String?
  branch_officer_phone String?

  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  webhook_events      WebhookEvent[]

  @@index([mobile_number])
  @@index([status])
}

model DailyGoldRate {
  id            String   @id @default(uuid())
  date          DateTime @unique
  rate_per_gram Float
  source        String   @default("IBJA_LOWER_OF_TWO")
  created_at    DateTime @default(now())
}

model WebhookEvent {
  id              String   @id @default(uuid())
  lead_id         String
  lead            Lead     @relation(fields: [lead_id], references: [id])
  status_sent     String
  payload         String   // JSON string of the full webhook payload
  delivery_status String   @default("pending") // pending, delivered, failed
  attempts        Int      @default(0)
  last_attempt_at DateTime?
  next_retry_at   DateTime?
  response_code   Int?
  error_message   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([lead_id])
  @@index([delivery_status])
  @@index([next_retry_at])
}
