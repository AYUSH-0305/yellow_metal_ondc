# ==========================================
# YELLOWMETAL BACKEND - ENVIRONMENT VARIABLES
# ==========================================

# Application Config
PORT=8080

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/yellowmetal?schema=public"

# Security / Authentication
# This is the exact string AarthikLabs must pass in their `x-api-key` header
AARTHIKLABS_API_KEY="dev_ym_aarthiklabs_secure_key_2026"

# Separate key for /api/internal/* (dashboard-facing) — a different trust
# boundary from AARTHIKLABS_API_KEY. Stopgap until the dashboard has real
# staff auth.
INTERNAL_API_KEY="dev_ym_internal_dashboard_key_2026"

# Outbound Webhook Configuration
# The URL where AarthikLabs wants to receive status updates from us
AARTHIKLABS_WEBHOOK_URL="https://webhook.site/b4a655bc-783b-4135-9ad2-760cae04f5c2"

# A shared secret we send in the x-webhook-secret header so AarthikLabs can verify it's really us
WEBHOOK_SECRET="dev_ym_webhook_secret_2026"

# Gold Spot API (used by goldRate.service.ts) — required, the service
# throws without these. Falls back to hardcoded rates if the fetch fails.
GOLD_API_URL="https://spot-app-bice.vercel.app/api/gold"
GOLD_API_KEY="your_gold_api_key"
