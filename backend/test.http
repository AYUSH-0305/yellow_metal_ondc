{
  "lead_id": "{LEAD_ID}"
}


### STEP 6: INTERNAL DASHBOARD TRIGGER (Fires the Webhook to AarthikLabs!)
# Replace {LEAD_ID} with the YMLEAD... ID returned in Step 3
# This simulates your Admin updating the loan to DISBURSED, which instantly sends 
# the webhook to preprod.credit.aarthiklabs.com
PATCH http://localhost:8080/api/internal/leads/YMLEAD901224/status
Content-Type: application/json

{
  "status": "DISBURSED",
  "disbursement_amount": 200000.0,
  "disbursement_date": "2026-09-24",
  "tenure": 12
}
